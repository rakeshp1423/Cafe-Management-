# Copy these values into your local shell or hosting-provider environment.
# This file is a template; Django does not automatically load .env files.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is used locally unless DATABASE_URL is set.
# PostgreSQL deployments must install the pgvector server extension.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Local Ollama. Install Ollama, then pull both models before ingesting/chatting.
CHATBOT_EMBEDDING_PROVIDER=ollama
CHATBOT_EMBEDDING_MODEL=all-minilm
CHATBOT_EMBEDDING_BASE_URL=http://localhost:11434
CHATBOT_LLM_PROVIDER=ollama
CHATBOT_MODEL=llama3.2:3b
CHATBOT_API_BASE_URL=http://localhost:11434

# Hosted OpenAI-compatible providers can be configured instead:
# CHATBOT_EMBEDDING_PROVIDER=openai
# CHATBOT_EMBEDDING_MODEL=text-embedding-3-small
# CHATBOT_EMBEDDING_BASE_URL=https://api.openai.com
# CHATBOT_LLM_PROVIDER=openai
# CHATBOT_MODEL=gpt-4o-mini
# CHATBOT_API_BASE_URL=https://api.openai.com
# CHATBOT_API_KEY=replace-with-your-provider-key

CHATBOT_TOP_K=4
CHATBOT_MAX_COSINE_DISTANCE=0.45
CHATBOT_MAX_MESSAGE_LENGTH=1000
CHATBOT_MAX_CONTEXT_CHARS=12000
CHATBOT_REQUEST_TIMEOUT=30
CHATBOT_MAX_OUTPUT_TOKENS=400
CHATBOT_CONVERSATION_RETENTION_DAYS=30
